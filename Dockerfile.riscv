# Dockerfile.riscv — minimal, RISC-V only (CH32V203)
# Base: Debian 13
# Size: ~600 MB

FROM debian:trixie

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    wget \
    make \
    riscv64-unknown-elf-gcc \
    riscv64-unknown-elf-gdb \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
VOLUME ["/workspace"]

CMD ["/bin/bash"]
