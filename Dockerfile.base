# Dockerfile.arm — minimal, ARM platforms only (RP2040, nRF52840)
# Base: Debian 13
# Size: ~700 MB

FROM debian:stable-slim
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    wget \
    make \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

CMD ["/bin/bash"]
