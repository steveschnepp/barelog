# Dockerfile.arm — minimal, ARM platforms only (RP2040, nRF52840)
# Base: Debian 13
# Size: ~700 MB

FROM debian:trixie

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    wget \
    make \
    arm-none-eabi-gcc \
    arm-none-eabi-gdb \
    libnewlib-arm-none-eabi \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
VOLUME ["/workspace"]

CMD ["/bin/bash"]
